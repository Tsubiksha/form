# ============================================================
# FormFlow — Environment Variables
# Copy to .env and fill in your values before starting.
# ============================================================

# PostgreSQL
POSTGRES_DB=formflow
POSTGRES_USER=formflow
POSTGRES_PASSWORD=change_this_strong_password

# Backend (FastAPI)
DATABASE_URL=postgresql://formflow:change_this_strong_password@db:5432/formflow
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
UPLOAD_DIR=uploads

# CORS — comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Frontend (Vite)
# For Docker, point to the backend container's public address
VITE_API_URL=http://localhost:8000
